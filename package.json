{
	"name": "oh-my-wechat",
	"private": true,
	"scripts": {
		"typecheck": "pnpm -r --parallel --if-present typecheck",
		"lint": "oxlint --type-aware && pnpm -r --parallel --if-present lint",
		"format": "oxfmt && pnpm -r --parallel --if-present format",
		"test": "pnpm -r --parallel --if-present test",
		"dev:web": "pnpm --filter web dev",
		"dev:desktop": "pnpm --filter desktop dev",
		"build:web": "pnpm --filter web build",
		"build:desktop": "pnpm --filter desktop build",
		"build:dev": "pnpm --filter desktop build:dev"
	},
	"devDependencies": {
		"oxfmt": "^0.32.0",
		"oxlint": "^1.47.0",
		"oxlint-tsgolint": "^0.13.0",
		"turbo": "^2.5.5",
		"typescript": "catalog:"
	},
	"packageManager": "pnpm@9.13.2"
}
