# syntax=docker/dockerfile:1
# This context is generated by scripts/build.mjs from the pinned submodule.
ARG EMSDK_IMAGE=emscripten/emsdk:3.1.40
FROM ${EMSDK_IMAGE} AS emsdk-base
ARG COMPILER_FLAGS
ENV INSTALL_DIR=/opt \
    FFMPEG_ST=yes \
    FFMPEG_MT="" \
    CFLAGS="-I/opt/include ${COMPILER_FLAGS}" \
    CXXFLAGS="-I/opt/include ${COMPILER_FLAGS}" \
    LDFLAGS="-L/opt/lib -I/opt/include ${COMPILER_FLAGS}" \
    EM_PKG_CONFIG_PATH=/opt/lib/pkgconfig:/emsdk/upstream/emscripten/system/lib/pkgconfig \
    PKG_CONFIG_PATH=/opt/lib/pkgconfig:/emsdk/upstream/emscripten/system/lib/pkgconfig \
    EM_TOOLCHAIN_FILE=/emsdk/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake
RUN apt-get update && apt-get install -y --no-install-recommends git pkg-config patch && rm -rf /var/lib/apt/lists/*
COPY upstream/build /upstream/build
COPY patches /build/patches
RUN cd /upstream && patch -l -p1 < /build/patches/linker-no-postproc.patch

FROM emsdk-base AS zlib-builder
ARG ZLIB_REPOSITORY
ARG ZLIB_COMMIT
WORKDIR /src
RUN git init && git remote add origin "$ZLIB_REPOSITORY" && git fetch --depth=1 origin "$ZLIB_COMMIT" && git checkout --detach FETCH_HEAD
RUN bash /upstream/build/zlib.sh && mkdir -p /opt/share/licenses && cp README /opt/share/licenses/zlib.LICENSE

FROM emsdk-base AS ffmpeg-builder
ARG FFMPEG_REPOSITORY
ARG FFMPEG_COMMIT
WORKDIR /src
RUN git init && git remote add origin "$FFMPEG_REPOSITORY" && git fetch --depth=1 origin "$FFMPEG_COMMIT" && git checkout --detach FETCH_HEAD
COPY --from=zlib-builder /opt /opt
COPY configure-flags.txt /build/configure-flags.txt
# Preserve the official linker's SDL and library requirements.
RUN embuilder build sdl2
RUN cd /upstream && patch -p1 < /build/patches/build-jobs.patch
RUN bash -c 'mapfile -t flags < /build/configure-flags.txt; bash /upstream/build/ffmpeg.sh "${flags[@]}"'
COPY upstream/src/bind /src/src/bind
COPY upstream/src/fftools /src/src/fftools
COPY upstream/LICENSE /build/ffmpeg-wasm.LICENSE
RUN mkdir -p /output && bash /upstream/build/ffmpeg-wasm.sh -lz -sEXPORT_ES6 -o /output/ffmpeg-core.js
RUN cp COPYING.LGPLv2.1 /output/ffmpeg.LICENSE && cp /opt/share/licenses/zlib.LICENSE /output/zlib.LICENSE && cp /build/ffmpeg-wasm.LICENSE /output/ffmpeg-wasm.LICENSE && chmod 644 /output/*

FROM scratch AS export
COPY --from=ffmpeg-builder /output/ /
