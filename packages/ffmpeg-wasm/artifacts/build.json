{
  "upstream": {
    "repository": "https://github.com/ffmpegwasm/ffmpeg.wasm.git",
    "tag": "v12.15",
    "commit": "71aa99d37c02a7b4c435275ca9ef50e612f6efa1",
    "coreVersion": "0.12.10",
    "wrapperVersion": "0.12.15",
    "ffmpegVersion": "n5.1.4",
    "emscriptenVersion": "3.1.40"
  },
  "sources": {
    "ffmpeg": {
      "repository": "https://github.com/FFmpeg/FFmpeg.git",
      "commit": "4729204c17f756e186d622060088371d10b34f7e"
    },
    "zlib": {
      "repository": "https://github.com/ffmpegwasm/zlib.git",
      "version": "v1.2.11",
      "commit": "cacf7f1d4e3d44d871b605da3b647f07d718623f"
    }
  },
  "profile": {
    "name": "wechat",
    "threads": "single",
    "format": "esm",
    "demuxers": [
      "pcm_s16le",
      "ogg",
      "hevc"
    ],
    "decoders": [
      "pcm_s16le",
      "speex",
      "hevc"
    ],
    "parsers": [
      "hevc"
    ],
    "encoders": [
      "pcm_s16le",
      "png"
    ],
    "muxers": [
      "wav",
      "image2"
    ],
    "filters": [
      "scale",
      "aresample"
    ],
    "protocols": [
      "file"
    ],
    "externalLibraries": [
      "zlib"
    ]
  },
  "toolchain": {
    "platform": "linux/amd64",
    "image": "emscripten/emsdk:3.1.40",
    "compilerFlags": "-O3 -msimd128"
  },
  "configure": [
    "--disable-everything",
    "--disable-network",
    "--disable-postproc",
    "--disable-gpl",
    "--disable-nonfree",
    "--disable-version3",
    "--disable-shared",
    "--enable-static",
    "--enable-small",
    "--enable-zlib",
    "--enable-demuxer=pcm_s16le,ogg,hevc",
    "--enable-decoder=pcm_s16le,speex,hevc",
    "--enable-parser=hevc",
    "--enable-encoder=pcm_s16le,png",
    "--enable-muxer=wav,image2",
    "--enable-filter=aformat,anull,atrim,format,hflip,null,transpose,trim,vflip,scale,aresample",
    "--enable-protocol=file"
  ]
}
